{
  "rewrites": [
    {"source": "/", "destination": "/profit-os/index.html"},
    {"source": "/premium-design.css", "destination": "/app/premium-design.css"},
    {"source": "/profit-os", "destination": "/profit-os/index.html"},
    {"source": "/profit-os/", "destination": "/profit-os/index.html"}
  ],
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/app/index.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/profit-os/index.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]}
  ]
}